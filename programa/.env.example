# MODELO do .env (este arquivo vai para o Git, o .env NAO).
# Copie para .env e preencha. Nunca coloque valores reais aqui.
#
# Provedor sem chave ou sem modelo e pulado sozinho.
# A ordem abaixo e a ordem de tentativa: se um falhar, tenta o proximo.
#
# *_MODEL        = modelo para questoes so de texto.
# *_MODEL_VISAO  = modelo para questoes COM imagem (precisa enxergar). Vazio = esse
#                  provedor so responde questoes sem imagem.
# Use sempre modelos GRATUITOS (confira no site de cada provedor).
ORDEM_PROVEDORES=gemini,groq,openrouter,ollama-cloud

# Modo automatico (se faltar no .env, vale "sim"; para desligar, escreva "nao").
# AUTOMATICO          = marca a alternativa sugerida e vai para a proxima pagina.
# AUTOMATICO_FINALIZAR = na pagina de resumo, clica em "Enviar tudo e terminar" e
#                        confirma. NAO TEM VOLTA. So age junto com AUTOMATICO=sim.
AUTOMATICO=sim
AUTOMATICO_FINALIZAR=sim

# Memoria (certas e erradas). Fica em %LOCALAPPDATA%\AssistenteQuiz\memoria, um arquivo
# por PC. Para os PCs dividirem o que aprenderam, use a nuvem (Firebase, plano gratuito):
# basta a SENHA DA MEMORIA (a janela de configuracao tem um campo para ela). Sem senha,
# o programa funciona so com a memoria deste PC.
# NOME_PC= so se quiser outro nome para este PC (o padrao e o nome do Windows).
MEMORIA_SENHA=
NOME_PC=

# Gemini (Google AI Studio). NAO ative faturamento no projeto.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MODEL_VISAO=

# Groq (plano gratis)
GROQ_API_KEY=
GROQ_MODEL=
GROQ_MODEL_VISAO=

# OpenRouter: os modelos PRECISAM terminar em :free. Nao compre creditos.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_MODEL_VISAO=

# Ollama Cloud (nao precisa instalar nada): chave em ollama.com/settings/keys.
# NAO adicione creditos: so o plano Free, para nao gastar.
OLLAMA_API_KEY=
OLLAMA_CLOUD_MODEL=
OLLAMA_CLOUD_MODEL_VISAO=
